                                <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="RadioButtonCheckGlyphFillDisabled" Color="#5CFFFFFF" />
                                <SolidColorBrush x:Key="RatingControlSelectedForeground" Color="#005FB8" />
                                <SolidColorBrush x:Key="RatingControlSelectedForegroundPointerOver" Color="#005FB8" />
                                <SolidColorBrush x:Key="RatingControlSelectedForegroundPressed" Color="#005FB8" />
                                <SolidColorBrush x:Key="RatingControlSelectedForegroundDisabled" Color="#37000000" />
                                <SolidColorBrush x:Key="ProgressBarForeground" Color="#005FB8" />
