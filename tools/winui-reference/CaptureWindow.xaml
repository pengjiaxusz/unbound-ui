                                <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPressed" Color="#005FB8" />
                                <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedDisabled" Color="#37000000" />
