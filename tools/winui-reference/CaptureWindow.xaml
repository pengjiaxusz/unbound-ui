                                <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedDisabled" Color="#5CFFFFFF" />
                                <SolidColorBrush x:Key="ToggleSplitButtonBackgroundChecked" Color="#005FB8" />
                                <SolidColorBrush x:Key="ToggleSplitButtonBackgroundCheckedPointerOver" Color="#005FB8" />
                                <SolidColorBrush x:Key="ToggleSplitButtonBackgroundCheckedPressed" Color="#005FB8" />
                                <SolidColorBrush x:Key="ToggleSplitButtonBackgroundCheckedDisabled" Color="#37000000" />
                                <SolidColorBrush x:Key="ToggleSplitButtonForegroundChecked" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ToggleSplitButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ToggleSplitButtonForegroundCheckedPressed" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ToggleSplitButtonForegroundCheckedDisabled" Color="#5CFFFFFF" />
                                <SolidColorBrush x:Key="ToggleSplitButtonBorderBrushChecked" Color="#005FB8" />
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#005FB8" />
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#005FB8" />
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#005FB8" />
