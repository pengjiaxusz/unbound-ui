                                <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#003E92" />
                                <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#005FB8" />
                                <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#003E92" />
                                <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#003E92" />
                                <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#005FB8" />
                                <SolidColorBrush x:Key="AppBarToggleButtonBackgroundChecked" Color="#005FB8" />
