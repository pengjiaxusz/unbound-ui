                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#005FB8" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#005FB8" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#37000000" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#5CFFFFFF" />
                                <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#005FB8" />
                                <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#005FB8" />
                                <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#005FB8" />
                                <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillDisabled" Color="#37000000" />
                                <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#005FB8" />
                                <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#005FB8" />
                                <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#005FB8" />
