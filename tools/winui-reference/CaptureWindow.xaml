<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUiReference.CaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinUI Reference">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 人工翻页检视条：位于 Host 之外，因此永远不会进入 RenderTargetBitmap 的像素。 -->
        <Grid x:Name="ReviewBar" Grid.Row="0" Height="46" Padding="10,0" Visibility="Collapsed"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="PrevPageButton" Content="◀ Prev" Click="OnPrevPageClick" />
                <TextBlock x:Name="PageLabel" VerticalAlignment="Center" MinWidth="240" />
                <Button x:Name="NextPageButton" Content="Next ▶" Click="OnNextPageClick" />
                <TextBlock x:Name="CachedBadge" Text="cached" VerticalAlignment="Center" Opacity="0.65" Visibility="Collapsed" />
                <ComboBox x:Name="JumpBox" MinWidth="180" PlaceholderText="Jump to control" SelectionChanged="OnJumpSelectionChanged" />
                <Button x:Name="CapturePageButton" Content="Capture page" Click="OnCapturePageClick" />
                <Button x:Name="OpenDirectoryButton" Content="Output folder" Click="OnOpenDirectoryClick" />
                <Button x:Name="ScaleToggleButton" Content="Actual size" Click="OnScaleToggleClick" />
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="HostScroller" Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled">
            <Viewbox x:Name="HostScaler" Stretch="Uniform" StretchDirection="DownOnly"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
            <!--
                Host 背景就是 WinUI 的页面基准面；资源字典把「跟随用户个性化」的强调色
                钉死成 Windows 11 默认蓝，使基线不随截图机器的主题色漂移。
                只覆盖对照组控件实际用到的键（复选框 / 滑块 / 开关），不改动其他资源。
            -->
            <Canvas x:Name="Host" Width="1920" Height="1080" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Canvas.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#005FB8" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#005FB8" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#005FB8" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" Color="#37000000" />
                                <!-- 选中描边同样必须钉死：它默认取系统强调色，不覆盖会随截图
                                     机器的个性化强调色漂移，在选中框外圈留下 1px 异色环。 -->
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#005FB8" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#005FB8" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#005FB8" />
                                <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" Color="#37000000" />
                                <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" Color="#5CFFFFFF" />
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="#005FB8" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#005FB8" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#005FB8" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#37000000" />
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="#005FB8" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#005FB8" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#005FB8" />
                                <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#37000000" />
                                <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#005FB8" />
                                <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#005FB8" />
                                <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#005FB8" />
                                <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#37000000" />
                                <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#005FB8" />
                                <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#005FB8" />
                                <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#005FB8" />
                                <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="#37000000" />
                                <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#5CFFFFFF" />
                                <!-- 第一批基准控件（ToggleButton / RadioButton / RatingControl /
                                     ProgressBar / ProgressRing / InfoBadge）同样从系统强调色取色。
                                     这里沿用上面「钉死 Windows 11 默认蓝」的做法，逐个覆盖模板
                                     实际使用的键，保证基线不随截图机器的个性化颜色漂移。 -->
