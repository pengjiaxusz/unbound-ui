                                <SolidColorBrush x:Key="InfoBadgeForegroundDisabled" Color="#5CFFFFFF" />
                                <!-- ProgressRing 在 WinUI 3 里直接引用通用的强调色别名画刷，
                                     不走控件专属键，因此把别名层也钉死。 -->
