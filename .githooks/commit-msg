#!/bin/sh
# Conventional Commits 提交信息校验（零依赖）
# 用法：git config core.hooksPath .githooks

msg_file="$1"

if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  echo "[commit-msg] 无法读取提交信息文件" >&2
  exit 1
fi

# 取第一行，跳过注释行与空行
subject=$(grep -m1 -v -e '^#' -e '^[[:space:]]*$' "$msg_file")

# 放行 Git 自动生成的提交信息
case "$subject" in
  "Merge "*) exit 0 ;;
  "Revert "*) exit 0 ;;
  "Initial commit"*) exit 0 ;;
  "fixup!"*) exit 0 ;;
  "squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?(!)?: [^[:space:]].*$'

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "[commit-msg] 提交信息不符合约定式提交规范：" >&2
  echo "  $subject" >&2
  echo "  正确格式: <type>[(scope)][!]: <description>" >&2
  echo "  type: feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert" >&2
  echo "  示例: docs: 添加架构设计文档" >&2
  echo "  详见 CONTRIBUTING.md" >&2
  exit 1
fi

# 禁止以句号结尾
case "$subject" in
  *.) echo "[commit-msg] description 结尾不要加句号" >&2; exit 1 ;;
esac

exit 0
