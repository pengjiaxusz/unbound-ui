#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// ---------------------------------------------------------------------------
// 稳定 LSD 基数排序，第 2/3 步：全局桶前缀扫描。
//
// 单个工作组，每个数字位值对应一个线程（共 256 线程）。每个线程仅遍历自身位值的
// 逐块直方图，因此整体扫描复杂度为每线程 O(block_count)，而非 O(256 × block_count) 串行。
// ---------------------------------------------------------------------------

#include "common.glsl"

layout(local_size_x = 256) in;

#define BLOCK 256u

layout(buffer_reference, std430, buffer_reference_align = 4) buffer U32Buf {
    uint v[];
};

shared uint s_digit_base[256];

void main() {
    uint d = gl_LocalInvocationID.x;
    U32Buf scratch = U32Buf(pc.scratch_bda5);
    uint hist_words = pc.block_count * BLOCK;
    uint blocks = pc.block_count;

    // 所有块中具有该位值的键总数。
    uint total = 0u;
    for (uint b = 0u; b < blocks; ++b) {
        total += scratch.v[b * BLOCK + d];
    }
    s_digit_base[d] = total;
    barrier();

    // 对各桶总数执行独占前缀和，由线程 0 一次性完成（256 次迭代）。
    if (d == 0u) {
        uint running = 0u;
        for (uint i = 0u; i < 256u; ++i) {
            uint t = s_digit_base[i];
            s_digit_base[i] = running;
            running += t;
        }
    }
    barrier();

    // 写回每个块对应该位值的起始偏移。
    uint running = s_digit_base[d];
    for (uint b = 0u; b < blocks; ++b) {
        uint c = scratch.v[b * BLOCK + d];
        scratch.v[hist_words + b * BLOCK + d] = running;
        running += c;
    }
}
