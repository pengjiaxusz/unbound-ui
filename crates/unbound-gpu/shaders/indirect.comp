#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// ---------------------------------------------------------------------------
// 阶段 3 — 间接绘制命令压缩（参见 `docs/architecture/gpu-renderer.md`）。
//
// 遍历已排序的键数组，为每个连续的 `(layer, barrier, variant)` 批次生成一条
// `VkDrawIndirectCommand`。由于排序优先按这三个字段排列，每个批次天然连续，
// 整帧只需一次 `vkCmdDrawIndirectCount` 即可完成绘制：计数缓冲区在此写入并直接
// 在 GPU 端消费，CPU 无需回读，也绝不会产生管线停顿。
//
// 保证正确性的三个关键细节：
//   * 未使用的键槽预先填充 `0xFFFF…` 并被排到末尾，遍历遇到首个哨兵即停止，避免绘制垃圾数据；
//   * `pc.aux` 限制最大批次数，防止极端场景溢出命令缓冲区；
//   * 对键数组的两趟扫描均为**并行**执行。单线程扫描十万个键需耗时约 10 毫秒（超过整帧
//     其余开销之和），因此哨兵查找与批次边界查找均分摊到工作组的 256 个通道上。
//
// 输出计数器：`c[1]` = 批次数（由 drawIndirectCount 读取），
//             `c[2]` = 可见实例数（用于诊断）。
// ---------------------------------------------------------------------------

#include "common.glsl"

layout(local_size_x = 256) in;

// 必须与渲染器中的 `MAX_DRAW_RUNS` 保持一致。
#define MAX_RUNS 16

layout(buffer_reference, std430, buffer_reference_align = 8) buffer KeyBuf {
    uint64_t k[];
};
layout(buffer_reference, std430, buffer_reference_align = 4) buffer CmdBuf {
    uint v[];  // 每条 DrawIndirectCommand 占 4 个 uint
};
layout(buffer_reference, std430, buffer_reference_align = 4) buffer CursorBuf {
    uint c[];
};

#define SENTINEL 0xFFFFFFFFFFFFFFFFul

shared uint s_end;
shared uint s_bound_count;
shared uint s_bounds[MAX_RUNS];

void emit(CmdBuf cmds, uint run, uint first, uint count) {
    uint o = run * 4u;
    cmds.v[o + 0u] = 4u;       // 顶点数
    cmds.v[o + 1u] = count;    // 实例数
    cmds.v[o + 2u] = 0u;       // 起始顶点
    cmds.v[o + 3u] = first;    // 起始实例 == 排序后槽位
}

void main() {
    uint n = pc.prim_count;
    CmdBuf cmds = CmdBuf(pc.scratch_bda2);
    CursorBuf counters = CursorBuf(pc.scratch_bda3);
    KeyBuf keys = KeyBuf(pc.scratch_bda);

    uint tid = gl_LocalInvocationID.x;
    uint threads = gl_WorkGroupSize.x;

    if (tid == 0u) {
        s_end = n;
        s_bound_count = 0u;
    }
    barrier();

    if (n == 0u) {
        if (tid == 0u) {
            counters.c[1] = 0u;
            counters.c[2] = 0u;
        }
        return;
    }

    // ---- 阶段 1：并行查找首个哨兵 ------------------------------------------
    uint my_end = n;
    for (uint i = tid; i < n; i += threads) {
        if (keys.k[i] == SENTINEL) {
            my_end = i;
            break;
        }
    }
    atomicMin(s_end, my_end);
    barrier();

    uint end = s_end;
    if (end == 0u) {
        if (tid == 0u) {
            counters.c[1] = 0u;
            counters.c[2] = 0u;
        }
        return;
    }

    // ---- 阶段 2：并行查找批次边界 ------------------------------------------
    // 边界是指批次前缀与其前驱不同的索引位置。
    // 每个索引恰好由一个通道访问，因此不会遗漏任何边界。
    for (uint i = tid + 1u; i < end; i += threads) {
        if (uint(keys.k[i] >> 36) != uint(keys.k[i - 1u] >> 36)) {
            uint slot = atomicAdd(s_bound_count, 1u);
            if (slot < uint(MAX_RUNS)) {
                s_bounds[slot] = i;
            }
        }
    }
    barrier();

    // ---- 阶段 3：对边界排序并生成绘制命令 ------------------------------------
    if (tid != 0u) {
        return;
    }
    uint count = min(s_bound_count, uint(MAX_RUNS));
    // 插入排序：最多 16 项，且必须有序以保持批次连续。
    for (uint a = 1u; a < count; ++a) {
        uint value = s_bounds[a];
        uint b = a;
        while (b > 0u && s_bounds[b - 1u] > value) {
            s_bounds[b] = s_bounds[b - 1u];
            b -= 1u;
        }
        s_bounds[b] = value;
    }

    uint max_runs = pc.aux;
    uint run = 0u;
    uint run_start = 0u;
    for (uint a = 0u; a < count; ++a) {
        uint boundary = s_bounds[a];
        emit(cmds, run, run_start, boundary - run_start);
        run += 1u;
        run_start = boundary;
        if (run >= max_runs) {
            // 命令缓冲区已满：停止压缩，丢弃剩余图元，防止越界写入分配区。
            counters.c[1] = run;
            counters.c[2] = end;
            return;
        }
    }
    emit(cmds, run, run_start, end - run_start);
    counters.c[1] = run + 1u;
    counters.c[2] = end;
}
