#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// ---------------------------------------------------------------------------
// 稳定 LSD 基数排序，第 1/3 步：逐块直方图统计。
//
// 每趟处理 8 位数字可将共享内存直方图控制在 1 KiB 并保证散布精确。8 趟覆盖完整 64 位键。
//
// 稳定性是 LSD 基数排序正确的前提：相等的键必须保持输入顺序，
// 否则节点内部的子元素顺序会每帧打乱，导致画家算法闪烁。
// ---------------------------------------------------------------------------

#include "common.glsl"

layout(local_size_x = 256) in;

#define BLOCK 256u

layout(buffer_reference, std430, buffer_reference_align = 8) buffer KeyBuf {
    uint64_t k[];
};
layout(buffer_reference, std430, buffer_reference_align = 4) buffer U32Buf {
    uint v[];
};

shared uint s_hist[BLOCK];

void main() {
    uint block = gl_WorkGroupID.x;
    uint base = block * BLOCK;
    if (base >= pc.prim_count) {
        return;
    }
    uint lid = gl_LocalInvocationID.x;
    if (lid < BLOCK) {
        s_hist[lid] = 0u;
    }
    barrier();

    uint count = min(BLOCK, pc.prim_count - base);
    if (lid < count) {
        uint64_t key = KeyBuf(pc.scratch_bda).k[base + lid];
        uint digit = uint((key >> pc.digit) & 0xFFu);
        atomicAdd(s_hist[digit], 1u);
    }
    barrier();

    // 直方图位于暂存缓冲区的前 `block_count * 256` 个 word 中；逐块偏移紧随其后。
    U32Buf hist = U32Buf(pc.scratch_bda5);
    if (lid < BLOCK) {
        hist.v[block * BLOCK + lid] = s_hist[lid];
    }
}
